{
  "buildCommand": "npm run build:holding",
  "crons": [
    {
      "path": "/api/sync-cashflow-cron",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/send-report-email-cron",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/send-billing-reminders-cron",
      "schedule": "0 9 * * 1,3,5"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|holding/|assets/|logo|favicon\\.svg|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
