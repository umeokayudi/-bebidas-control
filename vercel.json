{
  "crons": [
    {
      "path": "/api/sync-cashflow-cron",
      "schedule": "*/15 * * * *"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/holding", "dest": "/holding/index.html" },
    { "src": "/holding/(.*)", "dest": "/holding/index.html" },
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
