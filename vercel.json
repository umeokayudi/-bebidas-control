{
  "buildCommand": "npm run build:holding",
  "crons": [
    {
      "path": "/api/sync-cashflow-cron",
      "schedule": "*/15 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|holding/).*)",
      "missing": [{ "type": "filesystem" }],
      "destination": "/index.html"
    }
  ]
}
